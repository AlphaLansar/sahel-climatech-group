---
import Button from "./Button.astro";

interface Props {
  title: string;
  description: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const { title, description, primaryLabel, primaryHref, secondaryLabel, secondaryHref } =
  Astro.props;
---

<section class="container-page py-16 sm:py-20">
  <div
    class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-700 via-brand-800 to-brand-950 px-8 py-14 text-center sm:px-16 sm:py-16"
  >
    <div
      class="pointer-events-none absolute -right-10 -top-10 h-56 w-56 rounded-full bg-gold-400/20 blur-3xl"
    >
    </div>
    <h2 class="relative mx-auto max-w-2xl text-3xl font-bold text-white sm:text-4xl">{title}</h2>
    <p class="relative mx-auto mt-4 max-w-xl text-base leading-relaxed text-brand-100">
      {description}
    </p>
    <div class="relative mt-8 flex flex-wrap items-center justify-center gap-3">
      <Button href={primaryHref} variant="accent">
        {primaryLabel}
      </Button>
      {
        secondaryLabel && secondaryHref && (
          <Button href={secondaryHref} variant="outline">
            {secondaryLabel}
          </Button>
        )
      }
    </div>
  </div>
</section>
