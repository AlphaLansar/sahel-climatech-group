---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}
const { eyebrow, title, description, align = "left", class: className = "" } = Astro.props;
const isCenter = align === "center";
---

<div class={`max-w-3xl ${isCenter ? "mx-auto text-center" : ""} ${className}`}>
  {
    eyebrow && (
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-brand-600">{eyebrow}</p>
    )
  }
  <h2 class="text-3xl sm:text-4xl leading-tight">{title}</h2>
  {description && <p class="mt-4 text-lg leading-relaxed text-ink-600">{description}</p>}
</div>
