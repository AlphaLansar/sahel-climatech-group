---
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  icon: IconName;
  title: string;
  description: string;
  compact?: boolean;
}
const { icon, title, description, compact = false } = Astro.props;
---

<div
  class={`group rounded-2xl border border-ink-100 bg-white transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-lift ${compact ? "p-5" : "p-6"}`}
>
  <div
    class="mb-4 inline-flex size-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600 transition-colors group-hover:bg-brand-600 group-hover:text-white"
  >
    <Icon name={icon} class="size-5.5" />
  </div>
  <h3 class="text-base font-semibold text-ink-950">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-ink-600">{description}</p>
</div>
