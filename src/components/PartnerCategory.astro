---
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  icon: IconName;
  title: string;
  items: string[];
}
const { icon, title, items } = Astro.props;
---

<div class="rounded-2xl border border-ink-100 bg-white p-6">
  <div
    class="mb-4 inline-flex size-11 items-center justify-center rounded-xl bg-gold-50 text-gold-700"
  >
    <Icon name={icon} class="size-5.5" />
  </div>
  <h3 class="text-base font-semibold text-ink-950">{title}</h3>
  <ul class="mt-3 space-y-1.5">
    {
      items.map((item) => (
        <li class="flex items-start gap-2 text-sm text-ink-600">
          <Icon name="check" class="mt-0.5 size-3.5 shrink-0 text-brand-500" />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
</div>
