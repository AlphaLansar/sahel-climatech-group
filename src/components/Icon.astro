---
/**
 * Minimal hand-drawn line-icon set (24x24, stroke-based) so the site ships
 * zero external icon-font/JS dependency. Add new names as needed.
 */
export type IconName =
  | "climate"
  | "leaf"
  | "droplet"
  | "sun"
  | "cpu"
  | "satellite"
  | "robot"
  | "iot"
  | "flask"
  | "graduation"
  | "youth"
  | "rocket"
  | "digital"
  | "users"
  | "handshake"
  | "building"
  | "funder"
  | "mail"
  | "pin"
  | "arrow-right"
  | "external"
  | "menu"
  | "close"
  | "check"
  | "target"
  | "compass"
  | "chevron-down";

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = "size-6", strokeWidth = 1.75 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    name === "climate" && (
      <>
        <circle cx="12" cy="10" r="4.5" />
        <path d="M12 2v1.4M12 16.6V18M4.6 10H3M21 10h-1.6M6.7 4.7l1 1M17.3 4.7l-1 1" />
        <path d="M6 20c1.2-1.4 2.6-2 4-2h4c1.4 0 2.8.6 4 2" />
      </>
    )
  }
  {
    name === "leaf" && (
      <>
        <path d="M5 20c-1-6 1-11 6-13.5C16 4 19 5 20 5c0 1-1 4-3.5 6.5C14 14 9 16 5 20Z" />
        <path d="M5 20c2-3.5 4.5-6 8-8" />
      </>
    )
  }
  {name === "droplet" && <path d="M12 3s6 6.5 6 11a6 6 0 1 1-12 0c0-4.5 6-11 6-11Z" />}
  {
    name === "sun" && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
      </>
    )
  }
  {
    name === "cpu" && (
      <>
        <rect x="7" y="7" width="10" height="10" rx="1.5" />
        <rect x="10" y="10" width="4" height="4" rx="0.5" />
        <path d="M9 3v2.2M15 3v2.2M9 18.8V21M15 18.8V21M3 9h2.2M3 15h2.2M18.8 9H21M18.8 15H21" />
      </>
    )
  }
  {
    name === "satellite" && (
      <>
        <circle cx="12" cy="12" r="2.2" />
        <path d="M4 8 2.5 6.5M8 4 6.5 2.5M20 8l1.5-1.5M16 4l1.5-1.5" />
        <path d="M8.5 15.5 4 20M4 16v4h4" />
        <path d="M13.5 10.5 18 6" />
      </>
    )
  }
  {
    name === "robot" && (
      <>
        <rect x="5" y="9" width="14" height="10" rx="2.5" />
        <path d="M12 9V6M9.5 5.2h5" />
        <circle cx="9.5" cy="14" r="1.1" />
        <circle cx="14.5" cy="14" r="1.1" />
        <path d="M3 12.5v3M21 12.5v3M9 19v1.5M15 19v1.5" />
      </>
    )
  }
  {
    name === "iot" && (
      <>
        <circle cx="12" cy="12" r="1.6" />
        <circle cx="5" cy="6" r="1.4" />
        <circle cx="19" cy="6" r="1.4" />
        <circle cx="5" cy="18" r="1.4" />
        <circle cx="19" cy="18" r="1.4" />
        <path d="M6.2 7.1 10.8 10.9M17.8 7.1 13.2 10.9M6.2 16.9 10.8 13.1M17.8 16.9 13.2 13.1" />
      </>
    )
  }
  {
    name === "flask" && (
      <>
        <path d="M10 3h4M9.5 3v6.2L5.6 17a2 2 0 0 0 1.8 2.9h9.2a2 2 0 0 0 1.8-2.9L14.5 9.2V3" />
        <path d="M8 15h8" />
      </>
    )
  }
  {
    name === "graduation" && (
      <>
        <path d="M2.5 9 12 4.5 21.5 9 12 13.5 2.5 9Z" />
        <path d="M6.5 11v4.2c0 1 2.4 2.3 5.5 2.3s5.5-1.3 5.5-2.3V11" />
        <path d="M21.5 9v5.5" />
      </>
    )
  }
  {
    name === "youth" && (
      <>
        <circle cx="12" cy="7" r="3" />
        <path d="M5.5 20c0-3.6 3-6 6.5-6s6.5 2.4 6.5 6" />
        <path d="M9 20.5 12 22l3-1.5" />
      </>
    )
  }
  {
    name === "rocket" && (
      <>
        <path d="M12 2.5c2.8 1.6 4.5 4.6 4.5 8.2 0 2.3-.7 4.4-1.9 6.1l-2.6 2.7-2.6-2.7A10 10 0 0 1 7.5 10.7c0-3.6 1.7-6.6 4.5-8.2Z" />
        <circle cx="12" cy="10" r="1.8" />
        <path d="M8.5 17.5 6 20M15.5 17.5 18 20M9.5 19.5 8 22M14.5 19.5 16 22" />
      </>
    )
  }
  {
    name === "digital" && (
      <>
        <rect x="3" y="4.5" width="18" height="12" rx="1.5" />
        <path d="M8 20.5h8M12 16.5v4" />
      </>
    )
  }
  {
    name === "users" && (
      <>
        <circle cx="9" cy="8.5" r="3" />
        <path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5" />
        <path d="M15.5 6a3 3 0 0 1 0 5.8M21 20c0-2.6-1.8-4.6-4-5.3" />
      </>
    )
  }
  {
    name === "handshake" && (
      <>
        <path d="M2.5 12 7 8l3 2.3L14 7l3 2.5 4.5 4" />
        <path d="M7 8l4 5-1.6 1.6a1.6 1.6 0 0 1-2.4-2.1M14 7l4.5 5.5-1.7 1.8a1.6 1.6 0 0 1-2.4-2.1" />
        <path d="M10.7 15.9 12 17.3a1.6 1.6 0 0 0 2.4-2.1" />
      </>
    )
  }
  {
    name === "building" && (
      <>
        <rect x="5" y="3.5" width="10" height="17" rx="1" />
        <rect x="15" y="9" width="4.5" height="11.5" rx="1" />
        <path d="M8 7h1M11 7h1M8 10.5h1M11 10.5h1M8 14h1M11 14h1M17 12.5h.01M17 16h.01" />
      </>
    )
  }
  {
    name === "funder" && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5v9M9.3 9.8c0-1.1 1.2-2 2.7-2s2.7.9 2.7 1.9c0 2.5-5.4 1.2-5.4 3.7 0 1 1.2 1.9 2.7 1.9s2.7-.9 2.7-2" />
      </>
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="3" y="5.5" width="18" height="13" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
  {
    name === "pin" && (
      <>
        <path d="M12 21s7-6.3 7-11.5a7 7 0 1 0-14 0C5 14.7 12 21 12 21Z" />
        <circle cx="12" cy="9.5" r="2.4" />
      </>
    )
  }
  {name === "arrow-right" && <path d="M4 12h15M13 6l6 6-6 6" />}
  {
    name === "external" && (
      <>
        <path d="M9 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3" />
        <path d="M14 4h6v6M20 4 11 13" />
      </>
    )
  }
  {name === "menu" && <path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17" />}
  {name === "close" && <path d="M5 5l14 14M19 5 5 19" />}
  {name === "check" && <path d="M4.5 12.5 9.5 17.5 19.5 6.5" />}
  {
    name === "target" && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <circle cx="12" cy="12" r="4.5" />
        <circle cx="12" cy="12" r="0.9" fill="currentColor" />
      </>
    )
  }
  {
    name === "compass" && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="m14.8 9.2-1.6 4.4-4.4 1.6 1.6-4.4Z" />
      </>
    )
  }
  {name === "chevron-down" && <path d="m5.5 8.5 6.5 7 6.5-7" />}
</svg>
