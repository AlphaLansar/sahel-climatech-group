---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  class?: string;
}
const { image, alt, caption, class: className = "" } = Astro.props;
---

<figure
  class={`overflow-hidden rounded-3xl border border-ink-100 bg-ink-100 shadow-soft ${className}`}
>
  <Image
    src={image}
    alt={alt}
    width={1200}
    height={900}
    class="h-full w-full object-cover"
    quality="high"
  />
  {
    caption && (
      <figcaption class="border-t border-ink-100 bg-white px-5 py-3 text-sm text-ink-500">
        {caption}
      </figcaption>
    )
  }
</figure>
