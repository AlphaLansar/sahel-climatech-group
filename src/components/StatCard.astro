---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---

<div class="rounded-2xl border border-ink-100 bg-white p-6 shadow-soft">
  <p class="text-3xl font-bold text-brand-700 sm:text-4xl">{value}</p>
  <p class="mt-1.5 text-sm leading-snug text-ink-600">{label}</p>
</div>
