---
import Badge from "./Badge.astro";

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-950">
  <div
    class="pointer-events-none absolute -right-24 -top-32 h-96 w-96 rounded-full bg-brand-700/40 blur-3xl"
  >
  </div>
  <div
    class="pointer-events-none absolute -left-16 bottom-0 h-72 w-72 rounded-full bg-gold-500/15 blur-3xl"
  >
  </div>
  <div class="container-page relative py-20 sm:py-24">
    <Badge tone="gold" class="bg-white/10 text-gold-300 ring-white/20">{eyebrow}</Badge>
    <h1 class="mt-5 max-w-3xl text-4xl font-bold text-white sm:text-5xl">{title}</h1>
    {
      description && (
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-brand-100">{description}</p>
      )
    }
  </div>
</section>
