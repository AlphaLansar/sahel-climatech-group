---
interface Props {
  name: string;
  role: string;
  org?: string;
  initials: string;
}
const { name, role, org, initials } = Astro.props;
---

<div class="flex items-start gap-4 rounded-2xl border border-ink-100 bg-white p-5">
  <div
    class="flex size-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-brand-600 to-brand-800 text-sm font-bold text-white"
  >
    {initials}
  </div>
  <div>
    <p class="font-semibold text-ink-950">{name}</p>
    <p class="text-sm text-brand-700">{role}</p>
    {org && <p class="mt-0.5 text-xs text-ink-500">{org}</p>}
  </div>
</div>
