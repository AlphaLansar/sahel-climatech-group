---
import Icon, { type IconName } from "./Icon.astro";

/**
 * Every variant is a fully self-contained class string (bg + text + hover
 * states together) so two variants never partially conflict when composed
 * with an arbitrary `class` override — Tailwind's generated CSS order is
 * not guaranteed to follow DOM class order, so mixing e.g. `variant="primary"`
 * with a `class="bg-gold-400"` override is unsafe. Add a new variant instead
 * of overriding background/text utilities via the `class` prop.
 */
type Variant = "primary" | "accent" | "secondary" | "outline" | "ghost";

interface Props {
  href: string;
  variant?: Variant;
  icon?: IconName;
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = "primary",
  icon = "arrow-right",
  external = false,
  class: className = "",
} = Astro.props;

const base =
  "inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition-all duration-200 focus-visible:outline-none";
const variants: Record<Variant, string> = {
  // For light backgrounds.
  primary: "bg-brand-600 text-white shadow-soft hover:bg-brand-700 hover:shadow-lift",
  secondary:
    "bg-white text-brand-700 ring-1 ring-inset ring-brand-200 hover:ring-brand-400 hover:bg-brand-50",
  ghost: "text-brand-700 hover:bg-brand-50",
  // For dark backgrounds (hero, CTA sections).
  accent: "bg-gold-400 text-brand-950 shadow-soft hover:bg-gold-300 hover:shadow-lift",
  outline: "bg-transparent text-white ring-1 ring-inset ring-white/25 hover:bg-white/10 hover:ring-white/50",
};
---

<a
  href={href}
  class={`${base} ${variants[variant]} ${className}`}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <span>
    <slot />
  </span>
  <Icon name={external ? "external" : icon} class="size-4" />
</a>
