---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../consts";
import { withBase } from "../lib/url";
---

<BaseLayout
  lang="fr"
  path="/contact/"
  title="Contact"
  description="Contactez Sahel ClimaTech Group à Bamako, Mali, pour discuter recherche, partenariats, formation ou financement."
>
  <PageHeader
    eyebrow="Contact"
    title="Parlons de votre projet"
    description="Une question, une opportunité de collaboration ou de financement ? Écrivez-nous."
  />

  <section class="container-page py-20 sm:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="space-y-6">
        <div class="rounded-2xl border border-ink-100 bg-white p-6 shadow-soft">
          <div class="flex items-start gap-3">
            <span
              class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600"
            >
              <Icon name="mail" class="size-5" />
            </span>
            <div>
              <p class="text-sm font-semibold text-ink-950">Email</p>
              <a href={`mailto:${SITE.contactEmail}`} class="text-sm text-brand-700 link-underline">
                {SITE.contactEmail}
              </a>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-ink-100 bg-white p-6 shadow-soft">
          <div class="flex items-start gap-3">
            <span
              class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600"
            >
              <Icon name="pin" class="size-5" />
            </span>
            <div>
              <p class="text-sm font-semibold text-ink-950">Siège social</p>
              <p class="text-sm leading-relaxed text-ink-600">{SITE.address}</p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-ink-100 bg-white p-6 shadow-soft">
          <div class="flex items-start gap-3">
            <span
              class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600"
            >
              <Icon name="check" class="size-5" />
            </span>
            <div>
              <p class="text-sm font-semibold text-ink-950">Informations légales</p>
              <p class="text-sm leading-relaxed text-ink-600">
                Forme juridique, siège social et immatriculation :
                <a
                  href={withBase("/mentions-legales/")}
                  class="font-semibold text-brand-700 link-underline">mentions légales</a
                >.
              </p>
            </div>
          </div>
        </div>
      </div>

      <form
        id="contact-form"
        name="contact"
        class="space-y-5 rounded-3xl border border-ink-100 bg-white p-8 shadow-soft"
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class="text-sm font-medium text-ink-800">Nom complet</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="mt-1.5 w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100"
            />
          </div>
          <div>
            <label for="org" class="text-sm font-medium text-ink-800">Organisation</label>
            <input
              id="org"
              name="org"
              type="text"
              class="mt-1.5 w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100"
            />
          </div>
        </div>
        <div>
          <label for="email" class="text-sm font-medium text-ink-800">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="mt-1.5 w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100"
          />
        </div>
        <div>
          <label for="subject" class="text-sm font-medium text-ink-800">Sujet</label>
          <select
            id="subject"
            name="subject"
            class="mt-1.5 w-full rounded-xl border border-ink-200 bg-white px-3.5 py-2.5 text-sm text-ink-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100"
          >
            <option>Partenariat de recherche</option>
            <option>Financement / investissement</option>
            <option>Formation</option>
            <option>Presse</option>
            <option>Autre</option>
          </select>
        </div>
        <div>
          <label for="message" class="text-sm font-medium text-ink-800">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-1.5 w-full rounded-xl border border-ink-200 px-3.5 py-2.5 text-sm text-ink-900 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100"
          ></textarea>
        </div>
        <button
          type="submit"
          class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-soft transition hover:bg-brand-700 hover:shadow-lift"
        >
          Envoyer le message
          <Icon name="arrow-right" class="size-4" />
        </button>
        <p class="text-xs text-ink-500">
          Ce formulaire ouvre votre client de messagerie. Vous pouvez aussi écrire directement à <a
            href={`mailto:${SITE.contactEmail}`}
            class="link-underline">{SITE.contactEmail}</a
          >.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ contactEmail: SITE.contactEmail }}>
  const form = document.getElementById("contact-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = data.get("name") ?? "";
    const org = data.get("org") ?? "";
    const email = data.get("email") ?? "";
    const subject = data.get("subject") ?? "Contact";
    const message = data.get("message") ?? "";

    const body = [
      `Nom : ${name}`,
      org ? `Organisation : ${org}` : null,
      `Email : ${email}`,
      "",
      message,
    ]
      .filter(Boolean)
      .join("\n");

    const mailto = `mailto:${contactEmail}?subject=${encodeURIComponent(
      `[Site web] ${subject}`,
    )}&body=${encodeURIComponent(body)}`;
    window.location.href = mailto;
  });
</script>
