---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---

<BaseLayout
  lang="fr"
  path="/404/"
  title="Page introuvable — Page not found"
  description="Cette page n'existe pas. / This page does not exist."
>
  <section
    class="container-page flex min-h-[60vh] flex-col items-center justify-center py-24 text-center"
  >
    <p class="text-sm font-bold uppercase tracking-widest text-gold-700">404</p>
    <h1 class="mt-3 text-3xl font-bold text-ink-950 sm:text-4xl">Page introuvable</h1>
    <p class="mt-3 max-w-md text-ink-600">
      La page que vous cherchez n'existe pas ou a été déplacée.
    </p>
    <p class="mt-1 max-w-md text-sm text-ink-500">This page does not exist or has been moved.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/" variant="primary">Retour à l'accueil</Button>
      <Button href="/en/" variant="secondary">English home</Button>
    </div>
  </section>
</BaseLayout>
