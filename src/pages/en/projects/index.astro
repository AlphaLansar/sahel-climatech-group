---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import Badge from "../../../components/Badge.astro";
import Icon from "../../../components/Icon.astro";
---

<BaseLayout
  lang="en"
  path="/en/projects/"
  title="Projects"
  description="ForoSun-Tech: a smart solar greenhouse for climate-resilient agriculture, Sahel ClimaTech Group's flagship project, selected by the WASCAL WISE Grant program."
>
  <PageHeader
    eyebrow="Projects"
    title="From research to field prototype"
    description="Every Sahel ClimaTech project combines science, data and technology to address a concrete problem in the Sahel."
  />

  <section class="container-page py-20 sm:py-24">
    <a
      href="/en/projects/forosun-tech/"
      class="group grid gap-8 rounded-3xl border border-ink-100 bg-white p-8 shadow-soft transition-all hover:-translate-y-0.5 hover:shadow-lift sm:p-10 lg:grid-cols-[1fr_auto] lg:items-center"
    >
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <Badge tone="gold">Flagship project</Badge>
          <Badge tone="brand">Selected for funding — WASCAL WISE Grant</Badge>
        </div>
        <h2 class="mt-4 text-2xl font-bold text-ink-950 sm:text-3xl">ForoSun-Tech</h2>
        <p class="mt-1 text-base font-medium text-brand-700">
          A smart solar greenhouse for climate-resilient agriculture
        </p>
        <p class="mt-4 max-w-2xl leading-relaxed text-ink-600">
          A 144 m² pilot greenhouse in Marakacoungo (Koulikoro region, Mali), combining IoT, solar
          energy and artificial intelligence to optimize irrigation, indoor climate and agricultural
          productivity. Carried out with EUTG and ADKT.
        </p>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-500">
          <span class="flex items-center gap-1.5"
            ><Icon name="pin" class="size-4" /> Marakacoungo, Koulikoro</span
          >
          <span class="flex items-center gap-1.5"
            ><Icon name="target" class="size-4" /> 15 months</span
          >
          <span class="flex items-center gap-1.5"
            ><Icon name="funder" class="size-4" /> €20,000 — WASCAL WISE Grant</span
          >
        </div>
      </div>
      <span
        class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700 lg:whitespace-nowrap"
      >
        View project <Icon
          name="arrow-right"
          class="size-4 transition-transform group-hover:translate-x-1"
        />
      </span>
    </a>

    <div class="mt-10 rounded-2xl border border-dashed border-ink-200 p-8 text-center">
      <p class="text-sm text-ink-500">
        More applied research and training projects are in preparation. Check back soon — or
        <a href="/en/contact/" class="font-semibold text-brand-700 link-underline">get in touch</a>
        to build the next one together.
      </p>
    </div>
  </section>
</BaseLayout>
