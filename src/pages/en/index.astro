---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/Badge.astro";
import Button from "../../components/Button.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import PillarCard from "../../components/PillarCard.astro";
import StatCard from "../../components/StatCard.astro";
import CTASection from "../../components/CTASection.astro";
import PhotoFeature from "../../components/PhotoFeature.astro";
import Icon from "../../components/Icon.astro";
import teamPhoto from "../../assets/photos/team-group-photo.jpg";

const pillars = [
  {
    icon: "climate" as const,
    title: "Climate & resilience",
    description: "Climate risk analysis, climate services and decision-support tools.",
  },
  {
    icon: "leaf" as const,
    title: "Environment",
    description: "Ecosystem monitoring, land degradation and natural resource tracking.",
  },
  {
    icon: "droplet" as const,
    title: "Agriculture & water",
    description: "Smart agriculture, precision irrigation and food security.",
  },
  {
    icon: "sun" as const,
    title: "Clean energy",
    description: "Solar solutions, energy monitoring and autonomous systems.",
  },
  {
    icon: "cpu" as const,
    title: "AI & data science",
    description: "Predictive models, computer vision and time-series analysis.",
  },
  {
    icon: "iot" as const,
    title: "IoT & Edge AI",
    description: "Sensors, embedded systems and intelligence at the network edge.",
  },
  {
    icon: "robot" as const,
    title: "Robotics",
    description: "Autonomous systems, perception and field automation.",
  },
  {
    icon: "graduation" as const,
    title: "Training",
    description: "Capacity building in AI, data, robotics and climate technologies.",
  },
];
---

<BaseLayout
  lang="en"
  path="/en/"
  title="Sahel ClimaTech Group — Innovation and technology for the Sahel"
  description="A Malian innovation, applied research and technology organization dedicated to climate, environmental and agricultural resilience in the Sahel."
>
  <section
    class="relative overflow-hidden bg-gradient-to-b from-brand-950 via-brand-900 to-brand-950"
  >
    <div
      class="pointer-events-none absolute -right-32 -top-24 h-[28rem] w-[28rem] rounded-full bg-brand-600/30 blur-3xl"
    >
    </div>
    <div
      class="pointer-events-none absolute -left-24 bottom-0 h-80 w-80 rounded-full bg-gold-500/15 blur-3xl"
    >
    </div>

    <div
      class="container-page relative grid gap-12 py-20 sm:py-28 lg:grid-cols-[1.1fr_0.9fr] lg:items-center"
    >
      <div>
        <Badge tone="gold" class="bg-white/10 text-gold-300 ring-white/20">Bamako, Mali</Badge>
        <h1 class="mt-6 text-4xl font-bold leading-[1.08] text-white sm:text-5xl lg:text-[3.25rem]">
          Building the technology ecosystem of a <span class="text-gold-400">resilient Sahel</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-brand-100">
          Sahel ClimaTech Group designs artificial intelligence, IoT and applied research solutions
          for climate, environment, agriculture and energy — and trains the next generation of
          African engineers and researchers.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/en/projects/forosun-tech/" variant="accent">
            Discover ForoSun-Tech
          </Button>
          <Button href="/en/about/" variant="outline"> Our mission </Button>
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-brand-200">
          <span class="flex items-center gap-2"
            ><Icon name="check" class="size-4 text-gold-400" /> Scientific partnership — WASCAL</span
          >
          <span class="flex items-center gap-2"
            ><Icon name="check" class="size-4 text-gold-400" /> Academic partnership with EUTG</span
          >
        </div>
      </div>

      <div class="relative">
        <div
          class="rounded-3xl border border-white/10 bg-white/[0.04] p-6 shadow-2xl backdrop-blur-sm sm:p-8"
        >
          <div class="mb-6 flex items-center gap-3">
            <img
              src={`${import.meta.env.BASE_URL}assets/brand/logo-mark.png`}
              alt=""
              class="h-9 w-auto"
            />
            <div>
              <p class="text-sm font-semibold text-white">Sahel ClimaTech Group</p>
              <p class="text-xs text-brand-300">Climate • Data • AI • Robotics</p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            {
              [
                { icon: "climate" as const, label: "Climate" },
                { icon: "droplet" as const, label: "Water & agriculture" },
                { icon: "sun" as const, label: "Clean energy" },
                { icon: "cpu" as const, label: "AI & data" },
                { icon: "iot" as const, label: "IoT & Edge AI" },
                { icon: "robot" as const, label: "Robotics" },
              ].map((f) => (
                <div class="flex items-center gap-2.5 rounded-xl border border-white/10 bg-white/[0.03] px-3.5 py-3">
                  <Icon name={f.icon} class="size-5 text-gold-400" />
                  <span class="text-sm font-medium text-white">{f.label}</span>
                </div>
              ))
            }
          </div>
          <div class="mt-5 rounded-xl border border-gold-400/20 bg-gold-400/10 px-4 py-3.5">
            <p class="text-xs font-semibold uppercase tracking-wide text-gold-300">
              Flagship project
            </p>
            <p class="mt-1 text-sm font-medium text-white">ForoSun-Tech — smart solar greenhouse</p>
            <p class="mt-1 text-xs text-brand-200">WASCAL · EUTG · Bamako</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-ink-100 bg-brand-50/60">
    <div class="container-page py-10">
      <p
        class="mx-auto max-w-4xl text-center text-lg font-medium leading-relaxed text-ink-800 sm:text-xl"
      >
        “We don't just want to build technology for the Sahel. We want to help build the scientific,
        human and technological capacity that lets the Sahel develop its own solutions.”
      </p>
    </div>
  </section>

  <section class="container-page py-20 sm:py-24">
    <SectionHeading
      eyebrow="Focus areas"
      title="A multidisciplinary approach to real problems"
      description="Climate, environment, agriculture, water, energy, data, robotics and training: Sahel ClimaTech connects research, technology and the field."
    />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {pillars.map((p) => <PillarCard icon={p.icon} title={p.title} description={p.description} />)}
    </div>
    <div class="mt-8">
      <Button href="/en/focus-areas/" variant="ghost">See all 14 focus areas</Button>
    </div>
  </section>

  <section class="bg-ink-950 py-20 sm:py-24">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <Badge tone="gold">Flagship project</Badge>
          <h2 class="mt-5 text-3xl font-bold text-white sm:text-4xl">ForoSun-Tech</h2>
          <p class="mt-2 text-base font-medium text-brand-300">
            A smart solar greenhouse for climate-resilient agriculture
          </p>
          <p class="mt-5 max-w-xl leading-relaxed text-ink-300">
            A 144 m² pilot greenhouse in Marakacoungo (Koulikoro region), combining solar energy,
            IoT and artificial intelligence to optimize irrigation, indoor climate and productivity
            — with tomato as the pilot crop.
          </p>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-ink-400">
            Carried out in partnership with <strong class="text-ink-200">WASCAL</strong> and the École
            Universitaire de Technologie et de Gestion (EUTG).
          </p>
          <div class="mt-8">
            <Button href="/en/projects/forosun-tech/" variant="accent">
              View project details
            </Button>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <StatCard value="65–80%" label="Targeted water savings from smart irrigation" />
          <StatCard value="3–6×" label="Targeted yield vs. open-field (90–120 t/ha)" />
          <StatCard value="≥90%" label="Targeted accuracy of AI models" />
          <StatCard value="300+" label="Farmers, students & researchers to be trained" />
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-20 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <PhotoFeature
        image={teamPhoto}
        alt="Team and students of the Robotics & AI lab gathered at EUTG, Bamako"
        caption="Our community of engineers, students and researchers — EUTG, Bamako"
      />
      <div>
        <SectionHeading
          eyebrow="Our community"
          title="A new generation of African engineers and researchers"
          description="Sahel ClimaTech draws on a technical core trained at EUTG's Robotics & AI lab, and a growing network of students, faculty and partners engaged in applied research."
        />
        <ul class="mt-6 space-y-3 text-sm text-ink-600">
          <li class="flex items-start gap-2.5">
            <Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-600" /> Mentoring student projects
            in AI, robotics and embedded systems
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-600" /> Field prototyping and
            continuous experimentation
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-600" /> An open, collaborative
            research culture
          </li>
        </ul>
        <div class="mt-6">
          <Button href="/en/team/" variant="ghost">Meet the team</Button>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title="Let's build the Sahel's climate solutions together"
    description="Universities, NGOs, public institutions, companies or funders: let's explore how to collaborate on research, training or technology deployment."
    primaryLabel="Get in touch"
    primaryHref="/en/contact/"
    secondaryLabel="See partnerships"
    secondaryHref="/en/partners/"
  />
</BaseLayout>
